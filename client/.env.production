# Used by `vite build` (i.e. on Render's build step). Local dev keeps using client/.env.
# Note: Vite bakes these values into the bundled JavaScript at build time.
# If your API URL on Render is different (e.g. has a hash suffix), edit this file
# and re-push so the frontend rebuilds with the correct URL.
VITE_API_BASE_URL=https://foodieexpress-api.onrender.com/api/v1
VITE_STRIPE_PUBLISHABLE_KEY=
