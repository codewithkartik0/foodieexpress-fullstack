NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/foodieexpress

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-please-use-32+-random-bytes
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-32+-random-bytes-different
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=14d

# Bcrypt cost factor
BCRYPT_COST=12

# CORS – allowed origin(s), comma separated
CLIENT_ORIGIN=http://localhost:5173

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=inr

# Email delivery
# Preferred on Render / Railway / any host that blocks outbound SMTP: use Resend's HTTP API.
# Sign up free at https://resend.com (3000 emails/mo, no card). Paste the API key here.
RESEND_API_KEY=

# Legacy SMTP fallback (used only if RESEND_API_KEY is empty). Leave SMTP_HOST blank
# to print emails to stdout instead of sending. Note: SMTP is BLOCKED on Render --
# use Resend in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FoodieExpress <onboarding@resend.dev>"

# Frontend URL (used in password-reset emails)
APP_URL=http://localhost:5173

# Tax & delivery defaults (for cart/order pricing)
TAX_RATE=0.05
DELIVERY_FEE=49

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
