NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/foodieexpress

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-please-use-32+-random-bytes
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-32+-random-bytes-different
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=14d

# Bcrypt cost factor
BCRYPT_COST=12

# CORS – allowed origin(s), comma separated
CLIENT_ORIGIN=http://localhost:5173

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=inr

# Email delivery (in priority order: Brevo -> Resend -> SMTP -> stdout)
#
# Brevo (https://brevo.com) -- recommended for Render. No domain ownership
# required; verify a single sender email instead. 300 emails/day free.
BREVO_API_KEY=

# Resend (https://resend.com). Requires verified domain to send to arbitrary
# recipients. Useful if you own a domain and want polished branded sender.
RESEND_API_KEY=

# Legacy SMTP fallback (used only if BREVO/RESEND unset). Note: Render blocks
# outbound SMTP, so SMTP only works for local dev / non-Render hosts.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# The "from" address shown to recipients. Must match your verified sender at
# whichever provider you're using:
#   Brevo: must be the email you verified in their dashboard.
#   Resend (no verified domain): onboarding@resend.dev
#   Resend (verified domain):    any address @ that domain
EMAIL_FROM="FoodieExpress <your-verified-sender@example.com>"

# Frontend URL (used in password-reset emails)
APP_URL=http://localhost:5173

# Tax & delivery defaults (for cart/order pricing)
TAX_RATE=0.05
DELIVERY_FEE=49

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
